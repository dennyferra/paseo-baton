  "author": "Denny Ferrassoli",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "handoff",
    "agents",
    "coding-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennyferra/paseo-baton.git"
  },
  "homepage": "https://github.com/dennyferra/paseo-baton#readme",
  "bugs": {
    "url": "https://github.com/dennyferra/paseo-baton/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "client/",
    "server/",
    "shared/",
    "assets/",
    "index.client.tsx",
    "index.server.ts",
    "paseo-plugin.json",
    "OVERVIEW.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.11.2",
    "@getpaseo/protocol": "0.11.2",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  }
